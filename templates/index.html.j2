<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         max-width: 900px; margin: 0 auto; padding: 20px; color: #333; background: #fafafa; }
  h1 { margin-bottom: 24px; }
  .date-list { list-style: none; }
  .date-list li { margin-bottom: 8px; }
  .date-list a { color: #4a90d9; text-decoration: none; font-size: 1.1em; }
  .date-list a:hover { text-decoration: underline; }
  .features { list-style: none; margin-bottom: 32px; }
  .features li { margin-bottom: 10px; }
  .features a { color: #7b4ad9; text-decoration: none; font-size: 1.15em; font-weight: 600; }
  .features a:hover { text-decoration: underline; }
  h2 { font-size: 1.1em; color: #666; margin: 24px 0 12px; font-weight: 600; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
{% if features %}
<h2>专题精选</h2>
<ul class="features">
{% for feat in features %}
  <li><a href="{{ feat.slug }}.html">{{ feat.title }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% if dates %}
<h2>每日追踪</h2>
{% endif %}
<ul class="date-list">
{% for date in dates %}
  <li><a href="{{ date }}.html">{{ date }}</a></li>
{% endfor %}
</ul>
</body>
</html>
